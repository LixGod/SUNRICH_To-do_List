{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "sunrich-todo-frontend": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/sunrich-todo-frontend",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "styles": ["src/styles.css"],
            "assets": [{"glob": "**/*", "input": "public", "output": "/"}],
            "scripts": [],
            "serviceWorker": "ngsw-config.json",
            "optimization": { "fonts": { "inline": false } }
          },
          "configurations": {
            "development": {
              "optimization": false,
              "sourceMap": true,
              "serviceWorker": false
            }
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "sunrich-todo-frontend:build:development"
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
